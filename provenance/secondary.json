{
  "schema_version": 1,
  "scope": "fourteen secondary galgame engine algorithm units and knowledge pages",
  "runtime": {
    "dependencies": "Python standard library only",
    "import_time_io": false,
    "external_processes": false,
    "shared_layer_dependency": false,
    "input_output": "bytes/str and explicit structures in; structures/bytes/str out",
    "filesystem_policy": "caller owns sidecar identity checks, encoding preflight and safe output installation"
  },
  "source_repositories": {
    "msg-tool": {
      "commit": "f72716cee88554d40c1cdface2812493b14ca653",
      "license": "GPL-3.0-or-later"
    },
    "VNTextPatch-net8": {
      "commit": "d9c0fab7b72fdcf87d674ef12a84d3829c9188be",
      "license": "MIT"
    },
    "SExtractor": {
      "commit": "8d8d976fd04ae54e7c677705af937273d04a376a",
      "license": "GPL-3.0"
    }
  },
  "engines": [
    {
      "id": "circus",
      "knowledge": "engines/circus.md",
      "module": "python/engines/circus.py",
      "source_usage": "algorithm adaptation",
      "sources": [
        {
          "repository": "msg-tool",
          "path": "src/scripts/circus/script.rs",
          "symbols": [
            "CircusMesScript::new",
            "CircusMesScript::extract_messages",
            "CircusMesScript::import_messages"
          ]
        },
        {
          "repository": "msg-tool",
          "path": "src/scripts/circus/info.rs",
          "symbols": [
            "ScriptInfo",
            "Section::its",
            "SCRIPT_INFO"
          ]
        }
      ],
      "interfaces": [
        "Profile",
        "read_header",
        "read_token",
        "write_text_token"
      ],
      "implemented": [
        "explicit per-game opcode/key profile",
        "count-derived header offsets",
        "single-token boundary parsing",
        "additive byte decrypt/encrypt and NUL-collision rejection"
      ],
      "not_implemented": [
        "all game profiles",
        "whole MES writer",
        "block/jump relocation",
        "archive packing"
      ],
      "test_class": "CircusTests"
    },
    {
      "id": "hexenhaus",
      "knowledge": "engines/hexenhaus.md",
      "module": "python/engines/hexenhaus.py",
      "source_usage": "algorithm adaptation with stricter overflow rejection",
      "sources": [
        {
          "repository": "msg-tool",
          "path": "src/scripts/hexen_haus/bin.rs",
          "symbols": [
            "BinScript::new",
            "BinScript::extract_messages",
            "BinScript::import_messages"
          ]
        }
      ],
      "interfaces": [
        "Slot",
        "read_slots",
        "patch_slots",
        "split_name"
      ],
      "implemented": [
        "NORI recognition",
        "whole-file XOR 0x53",
        "_beginrp two-byte slot heuristic",
        "fixed-byte-capacity patch with space padding"
      ],
      "intentional_differences": [
        "never truncate overlength translation",
        "no automatic previous-slot name stealing",
        "reject translation separator collisions"
      ],
      "not_implemented": [
        "complete VM grammar",
        "cross-slot expansion",
        "archive writer"
      ],
      "cautions": [
        "upstream heuristic can miss short strings and alter discovered lengths after padding; preserve original slot identity"
      ],
      "test_class": "HexenhausTests"
    },

      "implementation": "Original bounded Python structure parsing and standard-library zlib/adler32, based on the cited format layout.",
      "public_api": [
        "extract(data: bytes, *, filter_name: str, ...)->list[Entry]",
        "build(files: list[tuple[str, bytes]], *, filter_name: str, ...)->bytes"
      ],
      "supported": [
        "Standalone XP3 standard File/info/segm/adlr",
        "raw or zlib index",
        "ordered raw/zlib segments, including repeated physical ranges",
        "Adler-32 checks",
        "new standard V1 writer"
      ],
      "refused": [
        "unknown or implicit filter_name",
        "nonzero info encryption flags",
        "unknown/duplicate index sections",
        "EXE overlays",
        "index chaining",
        "unknown compression flags",
        "truncated, oversized, mismatched or trailing zlib input"
      ],
      "caveat": "filter_name='none' is an explicit caller assertion; zero flags and Adler-32 are not proof that no unmarked game filter exists."
    },

      "implementation": "Independent allowlist interpreter over pickletools.genops; no pickle deserialization execution, no C# Pickle port.",
      "public_api": [
        "extract(data: bytes, ...)->list[Entry]"
      ],
      "supported": [
        "RPA-3.0 exact header",
        "bounded zlib index",
        "data-only pickle protocol 0..3 subset",

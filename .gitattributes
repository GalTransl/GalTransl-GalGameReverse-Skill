# Auto detect text files and perform LF normalization
* text=auto

# Upstream verbatim copies: keep bytes identical to recorded SHA-256
assets/ciallohook/upstream/** -text

# Bundled Locale Emulator / LE Plus binaries: never normalize
assets/ciallohook/locale-emulator/** -text

# Bundled rizin binaries and data: never normalize
assets/rizin/** -text
